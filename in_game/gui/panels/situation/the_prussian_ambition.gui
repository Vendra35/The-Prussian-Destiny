situation_panel = {

    ##################################### TOP HEADER (DUAL PORTRAIT) #####################################
    blockoverride "situation_panel_image" {
        using = two_countries_header_template
    
        blockoverride "FirstCountryContext" {
            datacontext = "[GetCountry('BRA')]"
        }

        blockoverride "SecondCountryContext" {
            datacontext = "[GetCountry('TEU')]"
        }

        blockoverride "first_character_portrait_anchor" {
            parentanchor = bottom|left
        }

        blockoverride "second_character_portrait_anchor" {
            parentanchor = bottom|right
        }

        blockoverride "character_religion_visibility" {
            visible = no
        }

        blockoverride "character_name_maximumsize" {
            maximumsize = { 270 -1 }
        }
    }

    ##################################### MAIN CONTENT #####################################
    blockoverride "situation_panel_main_content" {
        vbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            margin_left = 15
            margin_right = 15
            margin_bottom = 10
            margin_top = -10
            spacing = 8

            # 1. KART: DURUM AÇIKLAMASI
            situation_card_expandable = {
                blockoverride "header_button_onclick" {
                    onclick = "[LateralView.Vars.Toggle( 'prussia_desc_toggled' )]"
                }
                blockoverride "header_text" {
                    text = "the_prussian_ambition"
                }
                blockoverride "header_icon" {
                    texture = "gfx/interface/icons/traits/_default.dds"
                }
                blockoverride "bottom_content" {
                    text_multi = {
                        margin = { 15 10 }
                        layoutpolicy_horizontal = expanding
                        max_width = 460
                        autoresize = yes
                        text = "the_prussian_ambition_desc"
                        using = fontsize_medium
                    }
                }
                blockoverride "bottom_content_onclick" {
                    visible = "[LateralView.Vars.Exists( 'prussia_desc_toggled' )]"
                }
                blockoverride "icon_replace_visible_yes" {
                    visible = "[LateralView.Vars.Exists( 'prussia_desc_toggled' )]"
                }
                blockoverride "icon_replace_visible_not" {
                    visible = "[Not(LateralView.Vars.Exists( 'prussia_desc_toggled' ))]"
                }
            }

            # 2. KART: HEDEFLER LÝSTESÝ
            situation_card_expandable = {
                blockoverride "header_button_onclick" {
                    onclick = "[LateralView.Vars.Toggle( 'prussia_req_toggled' )]"
                }
                blockoverride "header_text" {
                    text = "END_REQUIREMENTS"
                }
                blockoverride "header_icon" {
                    texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
                }
                blockoverride "bottom_content" {
                    TooltipRequirementsList = {
                        textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
                        margin = { 15 10 }
                    }
                }
                blockoverride "bottom_content_onclick" {
                    visible = "[LateralView.Vars.Exists( 'prussia_req_toggled' )]"
                }
                blockoverride "icon_replace_visible_yes" {
                    visible = "[LateralView.Vars.Exists( 'prussia_req_toggled' )]"
                }
                blockoverride "icon_replace_visible_not" {
                    visible = "[Not(LateralView.Vars.Exists( 'prussia_req_toggled' ))]"
                }
            }

            # 3. KART: LÝDER BÝLGÝ VE KARÞILAÞTIRMA KARTI (Fancy Two Line Card)
            situation_fancy_two_line_card = {
                block "card_datacontext" { }
                
                # Left Side - Brandenburg
                blockoverride "left_flag_properties" {
                    datacontext = "[GetCountry('BRA')]"
                    visible = "[Country.IsValid]"
                }
                blockoverride "left_bottom_flag" { }
                blockoverride "left_top_text" {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[GetCountry('BRA').IsValid]"
                    text = "[GetCountry('BRA').GetName]"
                }
                blockoverride "left_bottom_text" {
                    # Liderlik skoru / durumu (Loc'den eklenecek)
                    text = "BRA_SCORE_TT"
                    tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_icon" {
							country_flag_small = {
								datacontext = "[GetCountry('BRA')]"
							}
						}
						blockoverride "title_text" {
							text = "PD_BRA_MILITARY_STRENGTH_BRA_TT_TITLE"
						}
						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								blockoverride "block_title" {
									visible = no
								}
                                textcontext = "PD_BRA_SCORE_TT"
							}							
						}						
					}
				}
                }
                
                # Right Side - Teutonic Order
                blockoverride "right_flag_properties" {
                    datacontext = "[GetCountry('TEU')]"
                    visible = "[Country.IsValid]"
                }
                blockoverride "right_bottom_flag" { }
                blockoverride "right_top_text" {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[GetCountry('TEU').IsValid]"
                    text = "[GetCountry('TEU').GetName]"
                }
                blockoverride "right_bottom_text" { 
                    # Liderlik skoru / durumu (Loc'den eklenecek)
                    text = "TEU_SCORE_TT"
                    tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_icon" {
							country_flag_small = {
								datacontext = "[GetCountry('TEU')]"
							}
						}
						blockoverride "title_text" {
							text = "PD_TEU_MILITARY_STRENGTH_TEU_TT_TITLE"
						}
						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								blockoverride "block_title" {
									visible = no
								}
								textcontext = "PD_TEU_SCORE_TT"
							}							
						}						
					}
				}
                }
            }

            # Alttaki boþluðu sýfýrlayan kod
            expand = {} 
        }
    }
}
