					tooltip = "PD_pa_step_meter_tt"
				}
			}
			blockoverride "bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					spacing = 8

					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 13
						text = "PD_pa_road_hint"
						default_format = "#subtle_name"
						tooltip = "PD_pa_step_meter_tt"
					}

					pd_pa_road_row = {
						blockoverride "pd_pa_road_tooltip" { tooltip = "PD_pa_step_1_tt" }
						blockoverride "pd_pa_road_done" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)2')]"
						}
						blockoverride "pd_pa_road_current" {
							visible = "[EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)1')]"
						}
						blockoverride "pd_pa_road_pending" { visible = no }
						blockoverride "pd_pa_road_name" { text = "PD_pa_step_1" }
						blockoverride "pd_pa_road_value" {
							text_single = {
								fontsize = 14
								visible = "[GreaterThanOrEqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)2')]"
								text = "PD_pa_state_done"
								default_format = "#G"
							}
							text_single = {
								fontsize = 14
								visible = "[EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)1')]"
								text = "PD_pa_state_current"
								default_format = "#Y"
							}
						}
					}

					pd_pa_road_row = {
						blockoverride "pd_pa_road_tooltip" { tooltip = "PD_pa_step_2_tt" }
						blockoverride "pd_pa_road_done" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)3')]"
						}
						blockoverride "pd_pa_road_current" {
							visible = "[EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)2')]"
						}
						blockoverride "pd_pa_road_pending" {
							visible = "[LessThan_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)2')]"
						}
						blockoverride "pd_pa_road_name" { text = "PD_pa_step_2" }
						blockoverride "pd_pa_road_value" {
							text_single = {
								fontsize = 14
								visible = "[GreaterThanOrEqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)3')]"
								text = "PD_pa_state_done"
								default_format = "#G"
							}
							text_single = {
								fontsize = 14
								visible = "[EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)2')]"
								text = "PD_pa_state_current"
								default_format = "#Y"
							}
							text_single = {
								fontsize = 14
								visible = "[LessThan_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)2')]"
								text = "PD_pa_state_ahead"
								default_format = "#subtle_name"
							}
						}
					}

					pd_pa_road_row = {
						blockoverride "pd_pa_road_tooltip" { tooltip = "PD_pa_step_3_tt" }
						blockoverride "pd_pa_road_done" { visible = no }
						blockoverride "pd_pa_road_current" {
							visible = "[EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)3')]"
						}
						blockoverride "pd_pa_road_pending" {
							visible = "[LessThan_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)3')]"
						}
						blockoverride "pd_pa_road_name" { text = "PD_pa_step_3" }
						blockoverride "pd_pa_road_value" {
							text_single = {
								fontsize = 14
								visible = "[EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)3')]"
								text = "PD_pa_state_current"
								default_format = "#Y"
							}
							text_single = {
								fontsize = 14
								visible = "[LessThan_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_current_step').GetValue, '(CFixedPoint)3')]"
								text = "PD_pa_state_ahead"
								default_format = "#subtle_name"
							}
						}
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 15
						text = "PD_pa_sec_diplomacy"
						default_format = "#T"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						icon = {
							size = { 16 16 }
							texture = "gfx/interface/progressbars/green_circle_bg.dds"
							visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_zollverein_asked').IsSet]"
						}
						icon = {
