							default_format = "#subtle_name"
						}
						expand = {}
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 15
						text = "PD_pa_sec_target"
						default_format = "#T"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						visible = "[And( EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_conquest_target').GetValue, '(CFixedPoint)1'), SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_conquest_target_country').GetCountry.IsValid )]"
						country_flag_small = {
							datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_conquest_target_country').GetCountry]"
						}
						text_single = {
							fontsize = 15
							text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_conquest_target_country').GetCountry.GetName]"
							tooltip = "PD_pa_target_tt"
						}
						expand = {}
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 14
						visible = "[Not(EqualTo_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_phase2_conquest_target').GetValue, '(CFixedPoint)1'))]"
						text = "PD_pa_target_none"
						default_format = "#subtle_name"
						tooltip = "PD_pa_target_tt"
					}
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'the_prussian_ascension_road_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'the_prussian_ascension_road_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'the_prussian_ascension_road_toggled' ))]"
			}
		}

		# CARD 4: how the situation ends.
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'the_prussian_ascension_req_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
					margin = { 15 10 }
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'the_prussian_ascension_req_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'the_prussian_ascension_req_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'the_prussian_ascension_req_toggled' ))]"
			}
		}

		# CARD 5: what a player can do, from each seat, and what the AI decides.
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'the_prussian_ascension_levers_toggled' )]"
			}
			blockoverride "header_text" {
				text = "PD_pa_levers_header"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/situations/the_prussian_ascension.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					margin = { 15 10 }
					layoutpolicy_horizontal = expanding
					max_width = 500
					autoresize = yes
					text = "PD_pa_levers_body"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'the_prussian_ascension_levers_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'the_prussian_ascension_levers_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'the_prussian_ascension_levers_toggled' ))]"
			}
		}
	}
}
