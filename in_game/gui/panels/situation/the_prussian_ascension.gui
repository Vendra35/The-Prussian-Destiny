						text_single = {
							fontsize = 14
							visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_zollverein_asked').IsSet)]"
							text = "PD_pa_zollverein_waiting"
							default_format = "#subtle_name"
						}
						expand = {}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						icon = {
							size = { 16 16 }
							texture = "gfx/interface/progressbars/red_circle_bg.dds"
							visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_austria_ultimatum_sent').IsSet]"
						}
						icon = {
							size = { 16 16 }
							texture = "gfx/interface/progressbars/empty_circle_bg.dds"
							visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_austria_ultimatum_sent').IsSet)]"
						}
						text_single = {
							fontsize = 14
							visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('PD_austria_ultimatum_sent').IsSet]"
